{
  "manifest_version": 3,
  "name": "回声Echo · AI求职助手",
  "version": "1.0.0",
  "description": "抓取招聘 JD、结合个人能力档案生成匹配打招呼语，岗位/公司评分、求职画像与总结（辅助型，手动发送）",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "alarms",
    "notifications",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.zhipin.com/*",
    "https://*.liepin.com/*",
    "https://*.zhaopin.com/*",
    "https://*.lagou.com/*",
    "https://api.deepseek.com/*",
    "https://aip.baidubce.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "回声Echo · AI求职助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://*.liepin.com/*",
        "https://*.zhaopin.com/*",
        "https://*.lagou.com/*"
      ],
      "js": [
        "content.js",
        "agent-page.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
